SWIFT_CONF_DIR=/etc/swift    # Chemin où sont montés les fichiers de configuration et les rings
SWIFT_USER=swift    # Nom de l'utilisateur système exécutant les processus Swift

PROXY_PORT=8080    # Port d'écoute du proxy HTTP
PROXY_BIND=0.0.0.0    # Adresse d'écoute du proxy

PROXY_AUTH_BACKEND=tempauth    # Backend d'authentification: tempauth pour tests, keystone pour prod
TEMPAUTH_USERS=admin:ADMIN:adminpw    # Utilisateurs tempauth (format user:account:password), tests uniquement

TLS_CERT_PATH=/etc/ssl/swift/fullchain.pem    # Chemin monté vers le certificat TLS du proxy
TLS_KEY_PATH=/etc/ssl/swift/privkey.pem    # Chemin monté vers la clé privée TLS du proxy
TLS_ENABLED=false    # Active TLS sur le proxy (true en production)

GENERATE_SELF_SIGNED_CERT=false    # Si true, init peut générer un certificat self-signed pour tests

DEVICES=127.0.0.1:/srv/node/sdb,127.0.0.1:/srv/node/sdc    # Liste devices pour ring-builder (ip:/srv/node/xxx,comma-separated)
REPLICAS=3    # Nombre de copies (réplicas) recommandé en production
PART_POWER=18    # Partition power (définit 2^PART_POWER partitions)
PARTITIONS=262144    # Nombre explicite de partitions (optionnel)
RING_REGION=1    # Region ID utilisée lors de l'ajout de devices au ring
RING_ZONE=1    # Zone ID utilisée lors de l'ajout de devices au ring
RING_STORAGE_PATH=/etc/swift    # Chemin où sont écrits les fichiers ring/builder

ACCOUNT_REPLICAS=3    # Nombre de réplicas pour les services account
CONTAINER_REPLICAS=3    # Nombre de réplicas pour les services container
OBJECT_REPLICAS=3    # Nombre de réplicas pour les services object
SWIFT_ROLE=object    # Rôle par défaut d'un container (object/container/account)

OBJECT_BASE_PORT=6000    # Port de base pour les serveurs object
CONTAINER_BASE_PORT=6001    # Port de base pour les serveurs container
ACCOUNT_BASE_PORT=6002    # Port de base pour les serveurs account

STORAGE_PATH=/srv/node    # Chemin de montage pour stockage sur chaque node
FS_TYPE=xfs    # Type de filesystem recommandé en production (xfs)
MOUNT_OPTIONS=noatime,nodiratime    # Options de montage recommandées pour perf

HOST_NETWORK=false    # Utiliser hostNetwork en k8s pour réduire latence réseau (true si besoin)
NETWORK_MTU=1500    # MTU réseau à configurer si overlay modifie la MTU

KEYSTONE_URL=http://keystone.example.local:5000/v3    # URL Keystone si PROXY_AUTH_BACKEND=keystone
KEYSTONE_PROJECT=service    # Projet/service utilisé pour Swift dans Keystone
KEYSTONE_USER=swift    # Utilisateur Keystone pour Swift
KEYSTONE_PASSWORD=changeme    # Mot de passe Keystone (ne pas stocker en clair en prod)
KEYSTONE_USER_DOMAIN=default    # Domaine utilisateur Keystone
KEYSTONE_PROJECT_DOMAIN=default    # Domaine projet Keystone

MEMCACHE_SERVERS=memcached:11211    # Liste memcached host:port pour cache d'auth
MEMCACHE_ENABLED=false    # Active l'utilisation de memcached dans le proxy

WAIT_TIMEOUT=120    # Timeout (s) pour wait-for-files.sh lors du démarrage
RECON_INTERVAL=3600    # Intervalle (s) entre runs du recon (repairs)
REPLICATOR_INTERVAL=300    # Intervalle (s) entre runs du replicator
AUDIT_INTERVAL=3600    # Intervalle (s) entre audits d'objets

LOG_LEVEL=INFO    # Niveau de logging (DEBUG/INFO/WARNING/ERROR)
LOG_DIR=/var/log/swift    # Dossier de logs à monter pour collecte

CPU_REQUEST=100m    # Request CPU pour k8s (valeur indicative)
CPU_LIMIT=500m    # Limit CPU pour k8s (valeur indicative)
MEMORY_REQUEST=128Mi    # Request mémoire pour k8s
MEMORY_LIMIT=1Gi    # Limit mémoire pour k8s

MAX_FILE_SIZE=5368709120    # Taille max d'objet en octets (ex: 5GB)
DISC_QUOTA=0    # Quota disque par container/account (0 = unlimited)

INIT_RUN=true    # Si true, entrypoints exécutent hooks d'init (chown/mkfs) au premier démarrage
FORCE_CHOWN=false    # Forcer chown sur les fichiers/configs si problèmes de permissions

METRICS_ENABLED=false    # Active l'export des métriques Prometheus
METRICS_PORT=9090    # Port d'export des métriques

PROBE_TIMEOUT=5    # Timeout (s) pour les probes liveness/readiness
PROBE_PERIOD=10    # Période (s) entre probes
PROBE_FAILURES=3    # Nombre d'échecs consécutifs avant marquer le pod/service comme unhealthy

K8S_NAMESPACE=swift    # Namespace Kubernetes recommandé pour le déploiement