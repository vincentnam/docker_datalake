##################################
# OPENSTACK KEYSTONE CONF
##################################

# Distribution or version of container used for Keystone build in Openstack LOCI


# Openstakc project version : use repository branch name (see https://releases.openstack.org/ and project repository :
# https://opendev.org/openstack/keystone/src/branch/stable/2026.1/ or
# https://opendev.org/openstack/horizon/src/branch/stable/2026.1/)
# May be change in 2027-10-27 (due to release calendar) and may be "unmaintained/2026.1"
OPENSTACK_RELEASE_VAR="stable/2026.1"

# name and version of base OS distribution (see https://hub.docker.com/_/ubuntu/ (as of 13th of May 2026 )
BASE_DISTRO_VAR="ubuntu:noble"

# Name for builded container : can be freely changed
BASE_TAG_VAR="ubuntu_noble"

#Admin account username for Keystone (used for bootstrap and admin operations)
OS_USERNAME="admin"

#Admin password for Admin account
OS_PASSWORD="pipi"
SWIFT_PASSWORD="pipi"

##################################
# KEYSTONE DATABASE CONF (MariaDB)
##################################
# Credentials used to provision the MariaDB instance backing Keystone.
# Root password is only used inside the container at provisioning time.
MYSQL_ROOT_PASSWORD="secret"
MYSQL_DATABASE="keystone"
MYSQL_USER="keystone"
MYSQL_PASSWORD="keystone_db_pass"

##################################
# OPENSTACK SWIFT CONF
##################################
# Define the number of management node of Openstack Swift (1 management node = 1 proxy server)
#NB_MANAGEMENT_NODE=1
NB_MANAGEMENT_NODE=1

#Define the number of storage node of Openstack Swift (1 storage node = 1 object server + 1 container server + 1 account server)
#NB_STORAGE_NODE=1
NB_STORAGE_NODE=1

# Used for truncate file size (see "man truncate" for more details)
# Needed to set up data storage for storage node of Openstack Swift cluster
# Total size used = NODE_STORAGE_SIZE * NB_STORAGE_NODE
# 1 truncate file is defined by node storage deployed
# NODE_STORAGE_SIZE="1GB"
NODE_STORAGE_SIZE="10GB"

# Random unique strings used to compute the storage path hashing (DO NOT LOSE
# once a cluster holds data : changing them makes existing data unreachable)
SWIFT_HASH_PREFIX="bd08f643f5663c4ec607"
SWIFT_HASH_SUFFIX="f423bf7ab663888fe832"

# Swift ring parameters (see "swift-ring-builder create <part_power> <replicas> <min_part_hours>")
# Number of replicas is kept equal to NB_STORAGE_NODE (1 storage node = 1 replica set of services)
SWIFT_PART_POWER=10
SWIFT_MIN_PART_HOURS=1

##################################
# KEYCLOAK / KEYSTONE FEDERATION CONF
##################################
# Master switch : enable the OIDC federation between Keystone and Keycloak.
# When "false", Keystone keeps working in pure password mode and no OIDC
# directive / identity provider is configured.
FEDERATION_ENABLED="true"

# Deploy the bundled Keycloak container (true) OR reuse an already existing /
# external Keycloak (false). When "false", no keycloak container is generated
# and KEYCLOAK_URL below must point to your existing instance.
DEPLOY_KEYCLOAK="true"

# INTERNAL base URL of Keycloak (NO trailing slash, NO /realms suffix), used for
# server-to-server calls : Flask <-> Keycloak token exchange and Keystone <->
# Keycloak JWKS validation. Reachable from inside the swift-cluster network.
#  - bundled Keycloak (DEPLOY_KEYCLOAK=true) default : http://keycloak:8080
#  - external Keycloak example                       : https://sso.example.com
KEYCLOAK_URL="http://keycloak:8080"

# PUBLIC base URL of Keycloak as seen FROM THE BROWSER (SSO login redirect).
# This is what the user's browser hits for the Keycloak login page, so it must
# be host-reachable. The bundled Keycloak is pinned to this URL (KC_HOSTNAME) so
# the token issuer stays stable. For an external Keycloak, set it equal to
# KEYCLOAK_URL. Default targets the bundled Keycloak host port below.
KEYCLOAK_PUBLIC_URL="http://localhost:8088"

# Realm that holds the datalake users
KEYCLOAK_REALM="datalake"

# OIDC client (relying party) declared in Keycloak for Keystone / Flask
KEYCLOAK_CLIENT_ID="keystone"
KEYCLOAK_CLIENT_SECRET="ChangeMe_keystone_client_secret"

# Optional explicit issuer override. Leave empty to derive it automatically as
# ${KEYCLOAK_PUBLIC_URL}/realms/${KEYCLOAK_REALM} (the issuer must match the URL
# the browser logs in through). Set it only for legacy Keycloak (Wildfly)
# instances that still serve realms under /auth/realms/<realm>.
KEYCLOAK_ISSUER=""

# Admin bootstrap credentials of the *bundled* Keycloak container only
# (ignored when DEPLOY_KEYCLOAK=false). Used to reach the Keycloak admin UI.
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="ChangeMe_keycloak_admin"

# Host port exposed for the bundled Keycloak (browser / admin console access)
KEYCLOAK_HOST_PORT="8088"

# Random passphrase used by Apache mod_auth_openidc to encrypt the session
# cookies / state. Change it and keep it secret.
OIDC_CRYPTO_PASSPHRASE="ChangeMe_long_random_oidc_passphrase_2026"

# Keystone-side identity provider id + federation protocol id.
# IMPORTANT: the protocol id must match a Keystone-registered auth method
# namespace. For OIDC the only valid choice is "mapped" (Keystone 2026.1 loads
# the auth method strictly by name; "openid" has no keystone.auth.openid driver).
KEYCLOAK_IDP_ID="keycloak"
KEYCLOAK_PROTOCOL_ID="mapped"

# Public URL of Keystone as seen from the browser, used to build the OIDC
# redirect URI (no /v3 suffix). In test mode Keystone is exposed on :5000.
KEYSTONE_PUBLIC_URL="http://localhost:5000"

# Keystone target for the federated users coming from Keycloak. The group is
# created in Keystone and granted FEDERATED_ROLE on FEDERATED_PROJECT; Keycloak
# group membership (claim "groups") is mapped onto it.
FEDERATED_DOMAIN="Default"
FEDERATED_GROUP="datalake_users"
FEDERATED_PROJECT="federated"
FEDERATED_ROLE="member"

# Sample user pre-provisioned in the bundled Keycloak realm (dev convenience)
KEYCLOAK_SAMPLE_USER="datalake-user"
KEYCLOAK_SAMPLE_PASSWORD="ChangeMe_datalake_user"

##################################
# FLASK CONF
##################################

# Keystone internal endpoint used by the Flask API (with /v3 suffix)
KEYSTONE_URL="http://keystone:5000/v3"

# Public base URL of the web GUI (browser side), used by Flask to redirect the
# user back after a successful Keycloak SSO login. Behind the nginx proxy the
# GUI is served on :7000 and the Flask API under /api.
WEB_GUI_URL="http://localhost:7000"

# Secret key used by Flask to sign the SSO session/state cookie. Change it.
FLASK_SECRET="ChangeMe_flask_session_secret"

##################################
# WEB GUI CONF
##################################

REACT_APP_JUPYTERHUB_URL="URL_CHANGEME"
REACT_APP_JUPYTERHUB_TOKEN="SECRET_CHANGEME"
REACT_APP_FLASK_APP_URL="http://localhost:7000/api"

##################################
# JUPYTERHUB CONF
##################################
# Version of JupyterHub used to build the hub image
JUPYTERHUB_VERSION="5.3.0"
# Username granted JupyterHub admin rights
JUPYTERHUB_ADMIN="admin"
# Image spawned by JupyterHub for each user notebook
DOCKER_NOTEBOOK_IMAGE="cors_base-notebook:latest"



##################################
# FIN CONF
##################################
