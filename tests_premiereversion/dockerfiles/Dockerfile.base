## Création des répertoires nécessaires pour Swift
#RUN mkdir -p /etc/swift /var/cache/swift /var/run/swift /srv/node && \
#    chown -R swift:swift /etc/swift /var/cache/swift /var/run/swift /srv/node
#
## Exposition des ports standards (adaptez selon service)
#EXPOSE 8080 6200 6201 6202
#
### Commande par défaut pour garder le conteneur en vie (overridez via command dans docker-compose)
#CMD ["tail", "-f" , "/dev/null"]

FROM ubuntu:24.04

ARG SWIFT_VERSION=2.34.0
ENV DEBIAN_FRONTEND=noninteractive

# Create swift user
RUN groupadd --system swift && useradd --system --create-home --home-dir /home/swift -g swift swift

RUN apt-get update -y && \
    apt-get upgrade -y && \
    apt-get install -y \
    curl \
    gcc \
    memcached \
    rsync \
    sqlite3 \
    xfsprogs \
    git \
    libffi-dev \
    liberasurecode-dev \
    libssl-dev \
    python3-coverage \
    python3-dev \
    python3-pytest \
    python3-xattr \
    python3-eventlet \
    python3-greenlet \
    python3-pastedeploy \
    python3-pip \
    python3-dnspython \
    ubuntu-cloud-keyring \
    software-properties-common \
    apt-transport-https && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Ajout du repository Ubuntu Cloud Archive pour OpenStack Epoxy
RUN add-apt-repository cloud-archive:epoxy -y && \
    apt-get update -y

# Installation des paquets Swift
RUN apt-get install -y \
    swift \
    swift-account \
    swift-container \
    swift-object \
    swift-proxy \
    python3-swiftclient \
    memcached && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create dirs
RUN mkdir -p /etc/swift /var/log/swift /var/cache/swift /srv/node /opt/swift-scripts \
  && chown -R swift:swift /etc/swift /var/log/swift /var/cache/swift /srv/node /opt/swift-scripts

# Copy entrypoints (ajoutés à l'étape 3)
COPY entrypoints/*.sh /opt/swift-scripts/
RUN chmod +x /opt/swift-scripts/*.sh && chown swift:swift /opt/swift-scripts/*.sh

USER swift
WORKDIR /home/swift

EXPOSE 8080 6000-6012
VOLUME ["/etc/swift", "/srv/node", "/var/log/swift"]

# CMD par défaut, overriden par compose
CMD ["/bin/bash"]