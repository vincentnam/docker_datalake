# Local disks configuration (read by disk_fallocate.sh)
# Command-line options -n / -s override DISK_NAME / DISK_SIZE.

# StorageClass whose discovery directory receives the disk (see local_static_provisioner.yml)
STORAGE_CLASS="swift-disks"

# Default disk name and size (fallocate syntax : 10G = 10 GiB, 10GB = 10^9 bytes)
DISK_NAME="d1"
DISK_SIZE="10G"

# Default filesystem : xfs (recommended by Swift) or ext4 (xattrs limited to ~4 KB per file)
DISK_FS="xfs"

# Where the image files are stored : local ext4/xfs filesystem,
# NOT under DISKS_ROOT and NOT on a Windows drive (/mnt/c, /mnt/h...)
IMG_DIR="/var/lib/local-disks"

# Discovery root of the local static provisioner (disks are mounted in DISKS_ROOT/STORAGE_CLASS/)
DISKS_ROOT="/mnt/disks"

# kubeconfig used by --apply (k3s default)
KUBECONFIG_FILE="/etc/rancher/k3s/k3s.yaml"

# uid:gid owning the root of the disk (empty = root).
# Set it once the swift UID is fixed in rawdata_zone/openstackSwift/Dockerfile.base
DISK_OWNER=""
